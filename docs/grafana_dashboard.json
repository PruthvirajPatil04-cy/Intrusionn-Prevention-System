  "liveNow": false,
  "panels": [
    {
      "title": "Packet Ingestion Rate (PPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(ips_packets_processed_total[1m])",
          "legendFormat": "Processed PPS"
        },
        {
          "expr": "rate(ips_packets_dropped_total[1m])",
          "legendFormat": "Dropped PPS"
        }
      ]
    },
    {
      "title": "Active Quarantine Blocks",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "ips_active_quarantine_ips",
          "legendFormat": "Quarantined IPs"
        }
      ]
    },
    {
      "title": "Alerts by Severity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (severity) (rate(ips_alerts_total[5m]))",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "title": "Analysis Latency p99 (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ips_analysis_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency"
        }
      ]
    }
  ],
  "refresh": "5s",
